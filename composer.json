{
    "name": "juggernautsei/oe-bamboo-pmp",
    "description": "OpenEMR Bamboo Health PDMP/PMP (NarxCare) reporting module",
    "minimum-stability": "stable",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Sherwin Gaddis",
            "email": "sherwingaddis@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*"
    },
    "scripts": {
        "test": ["@php tests/report-boundary.php", "@php tests/report-boundary.php --wrapped", "@php tests/setup-boundary.php"]
    },
    "type": "openemr-module",
    "keywords": [
        "openemr",
        "openemr-module",
        "pdmp",
        "pmp",
        "bamboo",
        "narxcare"
    ],
    "autoload": {
        "psr-4": {
            "Juggernaut\\Module\\Bamboo\\": "src/"
        }
    }
}
